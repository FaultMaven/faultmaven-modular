# =============================================================================
# FaultMaven Configuration
# =============================================================================
# Copy this file to .env and edit with your values
# For detailed documentation, see: docs/reference/configuration.md

# =============================================================================
# Deployment Profile
# =============================================================================
# Deployment tier: core (single user), team (small team), enterprise (organization)
PROFILE=core

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Multi-provider support allows using different providers for different tasks
# to optimize for cost, performance, and capability
#
# Get API keys:
#   OpenAI: https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/
#   Groq: https://console.groq.com/ (FREE tier - ultra-fast!)
#   Ollama: https://ollama.ai/ (FREE, local, private)

# Primary provider for main chat/diagnostic tasks (openai, anthropic, groq, ollama)
LLM_PROVIDER=openai

# Task-specific provider overrides (optional)
# If not specified, falls back to LLM_PROVIDER
# MULTIMODAL_PROVIDER=openai          # For visual evidence processing
# SYNTHESIS_PROVIDER=openai           # For RAG/document queries (use fast, cheap models)
# CODE_PROVIDER=openai                # For code analysis tasks

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini                  # Default: gpt-4o-mini (cost-effective)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# For OpenAI-compatible APIs (OpenRouter, Together AI, etc.):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Anthropic Configuration (Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Default model

# Groq Configuration (FREE tier - ultra-fast inference)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile          # Default model

# Ollama Configuration (FREE, local, private)
# Requires Ollama running locally: https://ollama.ai/
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2                       # Or: qwen2.5, mistral, etc.

# LLM Provider Behavior
LLM_REQUEST_TIMEOUT=30                    # Request timeout in seconds
LLM_MAX_RETRIES=3                         # Maximum retry attempts on failure
LLM_MAX_TOKENS=4096                       # Maximum tokens per request
# STRICT_PROVIDER_MODE=false              # If true, disable fallback to other providers

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (Development) - Data stored in local file
DATABASE_URL=sqlite+aiosqlite:///./data/faultmaven.db

# PostgreSQL (Production) - Recommended for team/enterprise deployments
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/faultmaven

# =============================================================================
# Redis Configuration (Session Storage and Caching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Full Redis URL (alternative to individual settings, used by Docker)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Session Management
# =============================================================================
# Session lifecycle and resource limits
SESSION_TIMEOUT_MINUTES=180               # Session timeout (3 hours default)
SESSION_CLEANUP_INTERVAL_MINUTES=30       # How often to run cleanup
SESSION_MAX_MEMORY_MB=100                 # Maximum memory per session
SESSION_HEARTBEAT_INTERVAL_SECONDS=30     # Frontend heartbeat interval
MAX_SESSIONS_PER_USER=10                  # Maximum concurrent sessions per user

# =============================================================================
# File Storage Configuration
# =============================================================================
# Local file storage (Development/Single-node)
FILE_STORAGE=local
FILE_STORAGE_PATH=./data/files

# S3 Storage (Production/Distributed)
# FILE_STORAGE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=faultmaven-files
# AWS_REGION=us-east-1

# File Upload Limits
# Maximum file upload size in MB (applies to evidence uploads and document processing)
# Recommendation: Don't exceed 50MB to avoid timeout or processing issues
MAX_UPLOAD_SIZE_MB=10

# Allowed MIME types for uploads (security control)
ALLOWED_MIME_TYPES=text/plain,text/csv,application/json,application/xml,text/xml,application/yaml

# Upload processing timeout
UPLOAD_TIMEOUT_SECONDS=300

# =============================================================================
# Vector Database Configuration (Knowledge Base)
# =============================================================================
# Vector store for semantic search in knowledge base
VECTOR_STORE=chromadb

# ChromaDB (Recommended for most deployments)
CHROMADB_PATH=./data/chromadb             # Local storage path
CHROMA_HOST=localhost                     # ChromaDB server host (for Docker)
CHROMA_PORT=8001                          # ChromaDB server port
# CHROMA_COLLECTION=faultmaven_kb         # Collection name (optional)
# EMBEDDING_MODEL=BAAI/bge-m3             # Embedding model (optional)

# Pinecone (Cloud-hosted alternative)
# VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=us-west1-gcp
# PINECONE_INDEX_NAME=faultmaven

# Vector search configuration
# SIMILARITY_THRESHOLD=0.7                # Minimum similarity score for results
# MAX_SEARCH_RESULTS=10                   # Maximum results to return

# =============================================================================
# Identity and Authentication
# =============================================================================
IDENTITY_PROVIDER=jwt

# JWT Configuration
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# The JWT_SECRET below is a placeholder and MUST be changed in production!
#
# Generate a strong secret key:
#   openssl rand -hex 32
#
# ❌ DO NOT use the default value in production!
# ❌ DO NOT commit your actual secret to version control!
#
JWT_SECRET=change-me-in-production-use-a-long-random-string  # ⚠️ CHANGE IN PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Network Configuration
# =============================================================================
# ⚠️ REQUIRED: Set your server's IP address or hostname
#
# This is used by the dashboard to connect to the backend API.
# - Use your server's IP for remote access (e.g., 192.168.1.100)
# - Use 'localhost' ONLY if dashboard will be accessed on the same machine
# - Use hostname if you have DNS (e.g., faultmaven.local)
#
# Examples:
#   SERVER_HOST=192.168.1.100    # Local network access
#   SERVER_HOST=faultmaven.local # Hostname
#   SERVER_HOST=localhost        # Same-machine only
#
# ❌ Common mistake: Leaving this empty will cause dashboard connection failures!
SERVER_HOST=localhost                    # ⚠️ CHANGE for remote access!

# =============================================================================
# Application Configuration
# =============================================================================
# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration (Allow dashboard and development servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
# ENVIRONMENT=development                 # development, staging, production
