#!/bin/bash
# ==============================================================================
# FaultMaven Modular Monolith CLI Wrapper
# ==============================================================================
# Simplifies deployment and management of FaultMaven services.
# Adapted from faultmaven-deploy for the unified monolith architecture.

set -e

# Ensure script is run from the correct directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
CLI_VERSION="2.0.0"
MIN_RAM_GB=4  # Reduced from 8GB (monolith is more efficient)
REQUIRED_COMMANDS=("docker" "curl")

# Deployment modes
PRODUCTION_MODE=false
DEPLOY_DIR="deploy/docker"

# CLI options
NO_COLOR=false
TAIL_LINES=""
YES_FLAG=false
INTERACTIVE=true

# Detect non-interactive mode (no tty)
if [ ! -t 0 ]; then
    INTERACTIVE=false
fi

# Docker compose wrapper
dc() {
    # Use root symlinks if they exist (standard), otherwise use deploy/ path
    if [ "$PRODUCTION_MODE" = true ]; then
        if [ -f docker-compose.prod.yml ]; then
            docker compose -f docker-compose.prod.yml "$@"
        else
            docker compose -f "$DEPLOY_DIR/docker-compose.prod.yml" "$@"
        fi
    else
        if [ -f docker-compose.yml ]; then
            docker compose "$@"
        else
            docker compose -f "$DEPLOY_DIR/docker-compose.yml" "$@"
        fi
    fi
}

# Health check services for monolith architecture
# Format: "container_name:port:service_name"
HEALTH_CHECK_SERVICES=(
    "faultmaven-backend:8000:FaultMaven API"
    "faultmaven-redis:6379:Redis"
    "faultmaven-chromadb:8000:ChromaDB"
)

# Production mode services (single unified container)
HEALTH_CHECK_SERVICES_PROD=(
    "faultmaven-core:8090:FaultMaven Core"
    "faultmaven-redis:6379:Redis"
    "faultmaven-chromadb:8000:ChromaDB"
)

# LLM provider environment variables
LLM_PROVIDERS=(
    "OPENAI_API_KEY:OpenAI"
    "ANTHROPIC_API_KEY:Anthropic"
    "GROQ_API_KEY:Groq"
    "OLLAMA_HOST:Ollama (Local)"
)

#######################################
# Utility Functions
#######################################

print_header() {
    echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}  FaultMaven Modular Monolith         ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
    if [ "$PRODUCTION_MODE" = true ]; then
        echo -e "${CYAN}🚀 Production Mode: Unified container on port 8090${NC}"
    else
        echo -e "${CYAN}🔧 Development Mode: API (8000) + Dashboard (3000)${NC}"
    fi
    echo ""
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

#######################################
# Pre-flight Checks
#######################################

check_dependencies() {
    local missing_deps=()

    for cmd in "${REQUIRED_COMMANDS[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [ ${#missing_deps[@]} -ne 0 ]; then
        print_error "Missing required dependencies: ${missing_deps[*]}"
        echo ""
        echo "Installation instructions:"
        echo "  - Docker: https://docs.docker.com/get-docker/"
        echo "  - curl: Usually pre-installed on Linux/Mac"
        exit 1
    fi
}

check_docker_running() {
    if ! docker info &> /dev/null; then
        print_error "Docker is not running"
        echo ""
        echo "Please start Docker Desktop or the Docker daemon and try again."
        exit 1
    fi
}

check_resources() {
    # Check available RAM (Linux and macOS compatible)
    if command -v free &> /dev/null; then
        # Linux
        total_ram_kb=$(free -k | awk '/^Mem:/ {print $2}')
        total_ram_gb=$((total_ram_kb / 1024 / 1024))
    elif command -v sysctl &> /dev/null; then
        # macOS
        total_ram_bytes=$(sysctl -n hw.memsize)
        total_ram_gb=$((total_ram_bytes / 1024 / 1024 / 1024))
    else
        print_warning "Unable to detect system RAM - skipping RAM check"
        return
    fi

    if [ "$total_ram_gb" -lt "$MIN_RAM_GB" ]; then
        print_warning "System has ${total_ram_gb}GB RAM (${MIN_RAM_GB}GB recommended)"
        echo "  FaultMaven may run slowly with limited memory"
    fi
}

check_env_file() {
    if [ ! -f .env ]; then
        print_warning ".env file not found"
        echo ""

        if [ -f .env.example ]; then
            if [ "$YES_FLAG" = true ] || [ "$INTERACTIVE" = false ]; then
                response="y"
            else
                read -p "Create .env from .env.example? (y/n) " -n 1 -r response
                echo
            fi

            if [[ $response =~ ^[Yy]$ ]]; then
                cp .env.example .env
                print_success "Created .env from template"
                echo ""
                print_warning "IMPORTANT: Edit .env and add your LLM API key before starting!"
                echo "  Example: OPENAI_API_KEY=sk-..."
                echo ""
                exit 0
            else
                print_error "Cannot start without .env file"
                exit 1
            fi
        else
            print_error ".env.example not found - cannot create .env"
            exit 1
        fi
    fi

    # Check for at least one LLM provider configured
    local llm_configured=false
    for provider in "${LLM_PROVIDERS[@]}"; do
        key="${provider%%:*}"
        if grep -q "^$key=" .env && ! grep -q "^$key=your-.*-key-here" .env && ! grep -q "^$key=\$" .env; then
            llm_configured=true
            break
        fi
    done

    if [ "$llm_configured" = false ]; then
        print_warning "No LLM provider configured in .env"
        echo "  Add at least one API key (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)"
        echo "  Or configure Ollama for local LLM (OLLAMA_HOST=http://localhost:11434)"
    fi
}

check_and_create_override() {
    if [ -f "$DEPLOY_DIR/examples/resource-limits.yml" ] && [ ! -f docker-compose.override.yml ]; then
        print_info "Resource limit examples available in deploy/docker/examples/"
        echo "  To customize: cp deploy/docker/examples/resource-limits.yml docker-compose.override.yml"
    fi
}

#######################################
# Commands
#######################################

cmd_start() {
    print_header
    local start_time=$(date +%s)
    echo "Starting FaultMaven services..."
    echo ""

    check_dependencies
    check_docker_running
    check_resources
    check_env_file
    check_and_create_override

    echo ""
    print_info "Starting containers..."
    echo ""

    if dc up -d; then
        echo ""
        print_info "Waiting for services to become healthy (up to 60 seconds)..."
        echo ""

        sleep 5  # Give containers time to start

        max_wait=60
        elapsed=0
        all_healthy=false

        while [ $elapsed -lt $max_wait ]; do
            # Check health using docker compose ps
            not_healthy=$(dc ps --format json 2>/dev/null | jq -s '[.[] | select(.Health != null and .Health != "healthy")] | length' 2>/dev/null || echo "0")
            total_services=$(dc ps --format json 2>/dev/null | jq -s 'length' 2>/dev/null || echo "0")

            if [ "$not_healthy" -eq 0 ] && [ "$total_services" -gt 0 ]; then
                all_healthy=true
                break
            fi

            echo -n "."
            sleep 5
            elapsed=$((elapsed + 5))
        done

        echo ""

        if [ "$all_healthy" = true ]; then
            local end_time=$(date +%s)
            local duration=$((end_time - start_time))
            echo ""
            print_success "FaultMaven started successfully! (${duration}s)"
            echo ""
            echo "Next steps:"
            echo "  1. Check status:  ./faultmaven status"
            echo "  2. View logs:     ./faultmaven logs"
            echo "  3. Access services:"
            if [ "$PRODUCTION_MODE" = true ]; then
                echo "     - FaultMaven:  http://localhost:8090"
                echo "     - API Docs:    http://localhost:8090/docs"
            else
                echo "     - Dashboard:   http://localhost:3000"
                echo "     - API:         http://localhost:8000"
                echo "     - API Docs:    http://localhost:8000/docs"
            fi
            echo ""
        else
            echo ""
            print_warning "Services started but may still be initializing"
            echo ""
            echo "Run './faultmaven status' in 30 seconds to verify."
            echo ""
        fi
    else
        echo ""
        print_error "Failed to start services"
        echo "Run './faultmaven logs' to see error details"
        exit 1
    fi
}

cmd_stop() {
    print_header
    echo "Stopping FaultMaven services..."
    echo ""

    if dc stop; then
        print_success "Services stopped"
    else
        print_error "Failed to stop services"
        exit 1
    fi
}

cmd_status() {
    print_header
    echo "Service Status:"
    echo ""

    # Use docker compose ps with format
    dc ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"

    echo ""

    # Check if core services are accessible
    if [ "$PRODUCTION_MODE" = true ]; then
        if curl -s http://localhost:8090/health &> /dev/null; then
            print_success "FaultMaven Core is healthy (port 8090)"
        else
            print_warning "FaultMaven Core not responding (port 8090)"
        fi
    else
        if curl -s http://localhost:8000/health &> /dev/null; then
            print_success "FaultMaven API is healthy (port 8000)"
        else
            print_warning "FaultMaven API not responding (port 8000)"
        fi
    fi
}

cmd_logs() {
    local service="${1:-}"
    local follow="${2:-}"

    if [ "$PRODUCTION_MODE" = true ]; then
        local default_service="faultmaven"
    else
        local default_service="faultmaven-backend"
    fi

    if [ -z "$service" ]; then
        service="$default_service"
    fi

    local opts=""
    if [ "$follow" = "-f" ] || [ "$follow" = "--follow" ]; then
        opts="-f"
    fi

    if [ -n "$TAIL_LINES" ]; then
        opts="$opts --tail=$TAIL_LINES"
    else
        opts="$opts --tail=100"
    fi

    dc logs $opts "$service"
}

cmd_restart() {
    print_header
    echo "Restarting FaultMaven..."
    echo ""

    cmd_stop
    echo ""
    cmd_start
}

cmd_clean() {
    print_header
    echo "Cleaning up stopped containers and unused images..."
    echo ""

    if [ "$YES_FLAG" = false ] && [ "$INTERACTIVE" = true ]; then
        read -p "This will remove stopped containers and dangling images. Continue? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled"
            exit 0
        fi
    fi

    dc down --remove-orphans
    docker system prune -f

    print_success "Cleanup complete"
}

cmd_nuke() {
    print_header
    print_warning "⚠️  DESTRUCTIVE OPERATION ⚠️"
    echo ""
    echo "This will:"
    echo "  - Stop and remove all containers"
    echo "  - Delete all volumes (databases, vector stores)"
    echo "  - Remove all images"
    echo ""
    echo "You will lose all data (cases, knowledge base, sessions)!"
    echo ""

    if [ "$YES_FLAG" = false ] && [ "$INTERACTIVE" = true ]; then
        read -p "Type 'DELETE' to confirm: " -r
        echo
        if [ "$REPLY" != "DELETE" ]; then
            echo "Cancelled"
            exit 0
        fi
    fi

    dc down --volumes --remove-orphans
    docker system prune -af --volumes

    print_success "Complete cleanup finished - all data removed"
}

cmd_version() {
    echo "FaultMaven CLI v${CLI_VERSION}"
    echo ""
    dc version
}

cmd_help() {
    cat <<EOF
FaultMaven Modular Monolith - Deployment Manager

USAGE:
    ./faultmaven [OPTIONS] COMMAND [ARGS]

COMMANDS:
    start           Start all FaultMaven services
    stop            Stop all services (preserves data)
    restart         Restart all services
    status          Show service status and health
    logs [SERVICE]  View logs (default: main app)
                    Add -f to follow logs in real-time
    clean           Remove stopped containers and unused images
    nuke            ⚠️  DESTROY EVERYTHING (stops services, deletes all data)
    version         Show version information
    help            Show this help message

OPTIONS:
    --prod          Use production mode (docker-compose.prod.yml)
    --tail N        Show last N lines of logs (default: 100)
    -y, --yes       Skip confirmation prompts (for automation)

EXAMPLES:
    ./faultmaven start                    # Start in development mode
    ./faultmaven --prod start             # Start in production mode
    ./faultmaven logs -f                  # Follow main app logs
    ./faultmaven logs faultmaven-redis    # View Redis logs
    ./faultmaven --tail 50 logs           # Show last 50 log lines
    ./faultmaven status                   # Check service health

MODES:
    Development (default):
      - Backend API:  http://localhost:8000
      - Dashboard:    http://localhost:3000
      - 4 containers: backend, dashboard, redis, chromadb

    Production (--prod):
      - Unified App:  http://localhost:8090
      - 3 containers: core (unified), redis, chromadb

For more help: https://github.com/FaultMaven/faultmaven/tree/main/docs
EOF
}

#######################################
# Main Entry Point
#######################################

# Parse global options
while [[ $# -gt 0 ]]; do
    case $1 in
        --prod|--production)
            PRODUCTION_MODE=true
            shift
            ;;
        --tail)
            TAIL_LINES="$2"
            shift 2
            ;;
        -y|--yes)
            YES_FLAG=true
            shift
            ;;
        start|stop|restart|status|logs|clean|nuke|version|help)
            COMMAND="$1"
            shift
            break
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run './faultmaven help' for usage information"
            exit 1
            ;;
    esac
done

# Execute command
case "${COMMAND:-help}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "$@"
        ;;
    clean)
        cmd_clean
        ;;
    nuke)
        cmd_nuke
        ;;
    version)
        cmd_version
        ;;
    help|*)
        cmd_help
        ;;
esac
